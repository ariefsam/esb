package projection

import (
	"context"
	"encoding/json"
	"errors"
	"log"
	"time"

	"gorm.io/gorm"
	"gorm.io/gorm/clause"

	"{{.ModuleName}}/domain"
	"{{.ModuleName}}/eventstore"
)

// {{.NamePascal}}ProjectionWorker keeps the {{.NamePascal}} balance + statement
// read models up to date by polling the event store.
type {{.NamePascal}}ProjectionWorker struct {
	events eventstore.EventRepository
	db     *gorm.DB
}

func New{{.NamePascal}}ProjectionWorker(events eventstore.EventRepository, db *gorm.DB) *{{.NamePascal}}ProjectionWorker {
	return &{{.NamePascal}}ProjectionWorker{events: events, db: db}
}

func (w *{{.NamePascal}}ProjectionWorker) Run(ctx context.Context) {
	for {
		if ctx.Err() != nil {
			return
		}
		cursor, err := w.readCursor(ctx)
		if err != nil {
			if ctx.Err() != nil {
				return
			}
			log.Printf("{{.Name}} projection: read cursor error: %v — retrying in 3s", err)
			if !w.wait(ctx, 3*time.Second) {
				return
			}
			continue
		}
		batch, err := w.events.FetchAll(ctx, []string{"{{.NameKebab}}"}, uint(cursor), 100)
		if err != nil {
			if ctx.Err() != nil {
				return
			}
			log.Printf("{{.Name}} projection: fetch error: %v — retrying in 3s", err)
			if !w.wait(ctx, 3*time.Second) {
				return
			}
			continue
		}
		// FetchAll returns as soon as the stream is drained — the
		// embedded store does not long-poll — so an idle worker without
		// this pause would spin a core.
		if len(batch) == 0 {
			select {
			case <-ctx.Done():
				return
			case <-time.After(500 * time.Millisecond):
			}
			continue
		}

		for _, e := range batch {
			if err := w.applyEvent(ctx, e); err != nil {
				if ctx.Err() != nil {
					return
				}
				// Stop at the first failure and re-fetch from the cursor. The
				// cursor only advances inside a successful applyEvent, so this
				// event is retried instead of skipped. An event that keeps
				// failing blocks the worker (visible in the log) rather than
				// silently leaving a hole in the read model.
				log.Printf("{{.Name}} projection: apply %s %d error: %v — retrying in 3s", e.EventName, e.ID, err)
				if !w.wait(ctx, 3*time.Second) {
					return
				}
				break
			}
		}
	}
}

// readCursor returns the ID of the last applied event. A missing row means
// nothing has been applied yet (0); any other error is returned so Run
// retries instead of silently replaying the stream from the start.
func (w *{{.NamePascal}}ProjectionWorker) readCursor(ctx context.Context) (int64, error) {
	var row ProjectionCursorRow
	err := w.db.WithContext(ctx).Where("name = ?", "{{.Name}}").First(&row).Error
	if errors.Is(err, gorm.ErrRecordNotFound) {
		return 0, nil
	}
	return row.AfterID, err
}

// wait pauses for d and reports false if ctx was cancelled first.
func (w *{{.NamePascal}}ProjectionWorker) wait(ctx context.Context, d time.Duration) bool {
	select {
	case <-ctx.Done():
		return false
	case <-time.After(d):
		return true
	}
}

func (w *{{.NamePascal}}ProjectionWorker) applyEvent(ctx context.Context, e eventstore.Event) error {
	return w.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
		switch e.EventName {
		case "{{.NamePascal}}Opened":
			var evt domain.{{.NamePascal}}Opened
			if err := json.Unmarshal(e.Data, &evt); err != nil {
				return err
			}
			row := {{.NamePascal}}BalanceRow{AggregateID: e.AggregateID, Currency: evt.Currency, Balance: 0, Version: e.Version, UpdatedAt: e.TimeMillis}
			if err := tx.Clauses(clause.OnConflict{DoNothing: true}).Create(&row).Error; err != nil {
				return err
			}

		case "{{.NamePascal}}Deposited":
			var evt domain.{{.NamePascal}}Deposited
			if err := json.Unmarshal(e.Data, &evt); err != nil {
				return err
			}
			if err := w.post(tx, e, "deposit", evt.Amount, evt.Ref); err != nil {
				return err
			}

		case "{{.NamePascal}}Withdrawn":
			var evt domain.{{.NamePascal}}Withdrawn
			if err := json.Unmarshal(e.Data, &evt); err != nil {
				return err
			}
			if err := w.post(tx, e, "withdraw", -evt.Amount, evt.Ref); err != nil {
				return err
			}

		case "{{.NamePascal}}Frozen":
			if err := tx.Model(&{{.NamePascal}}BalanceRow{}).Where("aggregate_id = ?", e.AggregateID).
				Updates(map[string]any{"frozen": true, "version": e.Version, "updated_at": e.TimeMillis}).Error; err != nil {
				return err
			}

		case "{{.NamePascal}}Closed":
			if err := tx.Model(&{{.NamePascal}}BalanceRow{}).Where("aggregate_id = ?", e.AggregateID).
				Updates(map[string]any{"closed": true, "version": e.Version, "updated_at": e.TimeMillis}).Error; err != nil {
				return err
			}
		}

		cursorCol := clause.Column{Name: "name"}
		return tx.Clauses(clause.OnConflict{
			Columns:   []clause.Column{cursorCol},
			DoUpdates: clause.AssignmentColumns([]string{"after_id", "updated_at"}),
		}).Create(&ProjectionCursorRow{Name: "{{.Name}}", AfterID: int64(e.ID), UpdatedAt: e.TimeMillis}).Error
	})
}

// post appends one statement line and applies the balance delta, but only when
// the line is new (unique EventID) — so re-applying an event is a no-op and the
// balance is never double-counted. signedAmount is negative for withdrawals.
func (w *{{.NamePascal}}ProjectionWorker) post(tx *gorm.DB, e eventstore.Event, kind string, signedAmount int64, ref string) error {
	entry := {{.NamePascal}}EntryRow{EventID: e.ID, AggregateID: e.AggregateID, Kind: kind, Amount: signedAmount, Ref: ref, At: e.TimeMillis}
	eventCol := clause.Column{Name: "event_id"}
	res := tx.Clauses(clause.OnConflict{Columns: []clause.Column{eventCol}, DoNothing: true}).Create(&entry)
	if res.Error != nil {
		return res.Error
	}
	if res.RowsAffected == 0 {
		return nil // already posted — idempotent no-op
	}
	return tx.Model(&{{.NamePascal}}BalanceRow{}).Where("aggregate_id = ?", e.AggregateID).
		Updates(map[string]any{"balance": gorm.Expr("balance + ?", signedAmount), "version": e.Version, "updated_at": e.TimeMillis}).Error
}

// WaitPast implements domain.ProjectionWaiter: it returns once this
// worker has applied the event with this ID, so a command can hold its
// answer until its own write is readable (see
// domain.StoreAndWaitProjectionWorker).
func (w *{{.NamePascal}}ProjectionWorker) WaitPast(ctx context.Context, aggregateName string, id uint) error {
	return NewCursorWaiter(w.db, "{{.Name}}", "{{.NameKebab}}").WaitPast(ctx, aggregateName, id)
}
