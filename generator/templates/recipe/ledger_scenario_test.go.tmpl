// Two concurrent withdrawals of the whole balance must not both succeed — the
// second loses on the optimistic-version check (or sees the drained balance).
// This is the double-spend guard the whole event-sourced design exists for.
func Test{{.NamePascal}}Service_ConcurrentWithdrawNoDoubleSpend(t *testing.T) {
	repo := eventstore.NewFakeStore()
	svc := New{{.NamePascal}}Service(repo)
	ctx := context.Background()
	if err := svc.Open(ctx, "{{.Name}}-1", "USD"); err != nil {
		t.Fatal(err)
	}
	if err := svc.Deposit(ctx, "{{.Name}}-1", 1000, "seed"); err != nil {
		t.Fatal(err)
	}

	var wg sync.WaitGroup
	errs := make([]error, 2)
	for i := 0; i < 2; i++ {
		wg.Add(1)
		go func(i int) {
			defer wg.Done()
			errs[i] = svc.Withdraw(ctx, "{{.Name}}-1", 1000, "race")
		}(i)
	}
	wg.Wait()

	success := 0
	for _, e := range errs {
		if e == nil {
			success++
		}
	}
	if success != 1 {
		t.Fatalf("expected exactly one withdrawal to succeed, got %d (errs: %v)", success, errs)
	}
}
