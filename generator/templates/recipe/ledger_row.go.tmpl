// {{.NamePascal}}EntryRow is one append-only ledger line (the statement). The
// unique EventID makes the projection idempotent: re-applying a source event
// never double-posts.
type {{.NamePascal}}EntryRow struct {
	ID          uint   `gorm:"primaryKey;autoIncrement" json:"id"`
	EventID     uint   `gorm:"uniqueIndex" json:"event_id"`
	AggregateID string `gorm:"index;column:aggregate_id" json:"aggregate_id"`
	Kind        string `gorm:"column:kind" json:"kind"`
	Amount      int64  `gorm:"column:amount" json:"amount"`
	Ref         string `gorm:"column:ref" json:"ref"`
	At          int64  `gorm:"column:at" json:"at"`
}

