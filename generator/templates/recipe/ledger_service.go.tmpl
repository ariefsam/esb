package service

import (
	"context"
	"encoding/json"
	"errors"
	"fmt"
	"time"

	"{{.ModuleName}}/domain"
)

// {{.NamePascal}}SnapshotInterval controls how often store() snapshots.
const {{.NamePascal}}SnapshotInterval = 100

var (
	Err{{.NamePascal}}Exists            = errors.New("{{.NameKebab}} already exists")
	Err{{.NamePascal}}NotFound          = errors.New("{{.NameKebab}} not found")
	Err{{.NamePascal}}Frozen            = errors.New("{{.NameKebab}} is frozen")
	Err{{.NamePascal}}InvalidAmount     = errors.New("amount must be positive")
	Err{{.NamePascal}}InsufficientFunds = errors.New("insufficient funds")
)

// {{.NamePascal}}Service handles commands for the {{.NamePascal}} ledger.
type {{.NamePascal}}Service struct {
	eventRepo domain.EventRepository
}

func New{{.NamePascal}}Service(repo domain.EventRepository) *{{.NamePascal}}Service {
	return &{{.NamePascal}}Service{eventRepo: repo}
}

// Open creates the account with a currency. Fails if it already exists.
func (s *{{.NamePascal}}Service) Open(ctx context.Context, id, currency string) error {
	agg, err := s.load(ctx, id)
	if err != nil {
		return err
	}
	if agg.Version > 0 {
		return Err{{.NamePascal}}Exists
	}
	return s.store(ctx, agg, "{{.NamePascal}}Opened", domain.{{.NamePascal}}Opened{Currency: currency})
}

// Deposit adds funds. amount is in the smallest currency unit and must be > 0.
func (s *{{.NamePascal}}Service) Deposit(ctx context.Context, id string, amount int64, ref string) error {
	agg, err := s.usable(ctx, id)
	if err != nil {
		return err
	}
	if amount <= 0 {
		return Err{{.NamePascal}}InvalidAmount
	}
	return s.store(ctx, agg, "{{.NamePascal}}Deposited", domain.{{.NamePascal}}Deposited{Amount: amount, Ref: ref})
}

// Withdraw removes funds, enforcing a non-negative balance. The invariant is
// checked on the loaded state, so a concurrent withdrawal that would overdraw
// loses on the optimistic-version check in store() (domain.ErrConflict).
func (s *{{.NamePascal}}Service) Withdraw(ctx context.Context, id string, amount int64, ref string) error {
	agg, err := s.usable(ctx, id)
	if err != nil {
		return err
	}
	if amount <= 0 {
		return Err{{.NamePascal}}InvalidAmount
	}
	if agg.Balance < amount {
		return Err{{.NamePascal}}InsufficientFunds
	}
	return s.store(ctx, agg, "{{.NamePascal}}Withdrawn", domain.{{.NamePascal}}Withdrawn{Amount: amount, Ref: ref})
}

// Freeze blocks deposits and withdrawals until unfrozen (idempotent).
func (s *{{.NamePascal}}Service) Freeze(ctx context.Context, id string) error {
	agg, err := s.load(ctx, id)
	if err != nil {
		return err
	}
	if agg.Version == 0 || agg.Closed {
		return Err{{.NamePascal}}NotFound
	}
	if agg.Frozen {
		return nil
	}
	return s.store(ctx, agg, "{{.NamePascal}}Frozen", domain.{{.NamePascal}}Frozen{})
}

// Close permanently closes the account (idempotent).
func (s *{{.NamePascal}}Service) Close(ctx context.Context, id string) error {
	agg, err := s.load(ctx, id)
	if err != nil {
		return err
	}
	if agg.Version == 0 {
		return Err{{.NamePascal}}NotFound
	}
	if agg.Closed {
		return nil
	}
	return s.store(ctx, agg, "{{.NamePascal}}Closed", domain.{{.NamePascal}}Closed{})
}

// usable loads the account and rejects it when missing, closed, or frozen —
// the shared precondition for Deposit/Withdraw.
func (s *{{.NamePascal}}Service) usable(ctx context.Context, id string) (*domain.{{.NamePascal}}, error) {
	agg, err := s.load(ctx, id)
	if err != nil {
		return nil, err
	}
	if agg.Version == 0 || agg.Closed {
		return nil, Err{{.NamePascal}}NotFound
	}
	if agg.Frozen {
		return nil, Err{{.NamePascal}}Frozen
	}
	return agg, nil
}

// esb:inject:service-commands

func (s *{{.NamePascal}}Service) load(ctx context.Context, id string) (*domain.{{.NamePascal}}, error) {
	agg := domain.New{{.NamePascal}}()
	agg.AggregateID = id

	var afterVersion int64
	snap, err := s.eventRepo.LatestSnapshot(ctx, id, domain.{{.NamePascal}}AggregateName)
	switch {
	case err == nil:
		if err := json.Unmarshal(snap.State, agg); err != nil {
			return nil, fmt.Errorf("restore snapshot: %w", err)
		}
		afterVersion = snap.Version
	case errors.Is(err, domain.ErrSnapshotNotFound):
	default:
		return nil, fmt.Errorf("load snapshot: %w", err)
	}

	events, err := s.eventRepo.Retrieve(ctx, id, domain.{{.NamePascal}}AggregateName, afterVersion)
	if err != nil {
		return nil, err
	}
	return agg, agg.Replay(events)
}

func (s *{{.NamePascal}}Service) store(ctx context.Context, agg *domain.{{.NamePascal}}, eventName string, data any) error {
	b, err := json.Marshal(data)
	if err != nil {
		return err
	}
	expectedVersion := agg.Version
	e := domain.Event{
		AggregateName: domain.{{.NamePascal}}AggregateName,
		AggregateID:   agg.AggregateID,
		EventName:     eventName,
		Version:       expectedVersion + 1,
		Data:          b,
		TimeMillis:    time.Now().UnixMilli(),
	}
	if _, err := s.eventRepo.StoreAtomic(ctx, e, expectedVersion); err != nil {
		return err
	}
	if err := agg.Apply(eventName, b); err != nil {
		return err
	}
	if agg.Version > 0 && agg.Version%{{.NamePascal}}SnapshotInterval == 0 {
		if state, err := json.Marshal(agg); err == nil {
			_, _ = s.eventRepo.StoreSnapshot(ctx, domain.{{.NamePascal}}AggregateName, agg.AggregateID, agg.Version, state)
		}
	}
	return nil
}
