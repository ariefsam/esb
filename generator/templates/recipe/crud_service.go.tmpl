// {{.NamePascal}}SnapshotInterval controls how often store() persists a full
// aggregate snapshot to speed up load().
const {{.NamePascal}}SnapshotInterval = 100

var (
	// Err{{.NamePascal}}NotFound is returned by Update/Archive when the entity
	// does not exist (or was already archived).
	Err{{.NamePascal}}NotFound = errors.New("{{.NameKebab}} not found")
	// Err{{.NamePascal}}Exists is returned by Create when the entity already
