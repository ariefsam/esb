// Create records a {{.NamePascal}}Created event. It fails if the aggregate
// already exists (invariant checked on the loaded state, so a concurrent
// create loses on the optimistic-version check in store()).
func (s *{{.NamePascal}}Service) Create(ctx context.Context, id string, in {{.NamePascal}}Input) error {
	agg, err := s.load(ctx, id)
	if err != nil {
		return err
	}
	if agg.Version > 0 {
		return Err{{.NamePascal}}Exists
	}
	return s.store(ctx, agg, "{{.NamePascal}}Created", domain.{{.NamePascal}}Created{
{{range .Fields}}		{{.NamePascal}}: in.{{.NamePascal}},
{{end}}	})
}

// Update records a {{.NamePascal}}Updated event. It fails if the aggregate
// does not exist or has been archived.
func (s *{{.NamePascal}}Service) Update(ctx context.Context, id string, in {{.NamePascal}}Input) error {
	agg, err := s.load(ctx, id)
	if err != nil {
		return err
	}
	if !agg.Exists() {
		return Err{{.NamePascal}}NotFound
	}
	return s.store(ctx, agg, "{{.NamePascal}}Updated", domain.{{.NamePascal}}Updated{
{{range .Fields}}		{{.NamePascal}}: in.{{.NamePascal}},
{{end}}	})
}

// Archive records a {{.NamePascal}}Archived event (soft delete). It fails if
// the aggregate never existed, and is idempotent when already archived (a
// retried Archive is a no-op success rather than an error).
func (s *{{.NamePascal}}Service) Archive(ctx context.Context, id string) error {
	agg, err := s.load(ctx, id)
	if err != nil {
		return err
	}
	if agg.Version == 0 {
		return Err{{.NamePascal}}NotFound
	}
	if agg.Archived {
		return nil
	}
	return s.store(ctx, agg, "{{.NamePascal}}Archived", domain.{{.NamePascal}}Archived{})
}

