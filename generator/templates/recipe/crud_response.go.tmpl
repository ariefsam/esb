package handler

import (
	"encoding/json"
	"errors"
	"log"
	"net/http"
)

// writeJSON writes v as a JSON response with the given status code.
func writeJSON(w http.ResponseWriter, status int, v any) {
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(status)
	_ = json.NewEncoder(w).Encode(v)
}

// writeError writes an {"error": "..."} JSON body with the given status code.
// 4xx errors are the client's to fix, so their message is returned as is. A
// 5xx error can carry internals (SQL, file paths, upstream responses): it is
// logged server-side and the client only sees the generic status text.
func writeError(w http.ResponseWriter, status int, err error) {
	msg := err.Error()
	if status >= http.StatusInternalServerError {
		log.Printf("handler: %d: %v", status, err)
		msg = http.StatusText(status)
	}
	writeJSON(w, status, map[string]string{"error": msg})
}
