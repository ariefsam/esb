// The actor set on the context by the auth middleware is stored with the
// event; without one, events carry domain.SystemActor().
func Test{{.NamePascal}}Service_CreateRecordsActor(t *testing.T) {
	repo := eventstore.NewFakeStore()
	svc := New{{.NamePascal}}Service(repo)
	in := {{.NamePascal}}Input{
{{range .Fields}}		{{.NamePascal}}: {{.Sample}},
{{end}}	}
	actor := domain.Actor{ActorID: "user-1", ActorName: "Test User"}
	testkit.Given(t, repo, domain.{{.NamePascal}}AggregateName, "{{.Name}}-1").
		When(func(ctx context.Context) error { return svc.Create(domain.WithActor(ctx, actor), "{{.Name}}-1", in) }).
		Then(testkit.Event("{{.NamePascal}}Created", domain.{{.NamePascal}}Created{
			Actor: actor,
{{range .Fields}}			{{.NamePascal}}: {{.Sample}},
{{end}}		}))
}

