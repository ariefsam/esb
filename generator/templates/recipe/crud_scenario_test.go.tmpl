	testkit.Given(t, repo, domain.{{.NamePascal}}AggregateName, "{{.Name}}-1",
		testkit.Event("{{.NamePascal}}Created", domain.{{.NamePascal}}Created{
{{range .Fields}}			{{.NamePascal}}: {{.Sample}},
{{end}}		}),
		testkit.Event("{{.NamePascal}}Archived", domain.{{.NamePascal}}Archived{}),
	).
		When(func(ctx context.Context) error { return svc.Archive(ctx, "{{.Name}}-1") }).
		Then() // no new event
}

