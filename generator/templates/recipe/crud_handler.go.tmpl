// {{.NamePascal}}Handler exposes the write-side commands for the {{.NamePascal}}
// aggregate over HTTP. The read side is {{.NamePascal}}QueryHandler.
type {{.NamePascal}}Handler struct {
	svc *service.{{.NamePascal}}Service
}

func New{{.NamePascal}}Handler(svc *service.{{.NamePascal}}Service) *{{.NamePascal}}Handler {
	return &{{.NamePascal}}Handler{svc: svc}
}

// Create handles POST: body {"id": "...", <fields>}.
func (h *{{.NamePascal}}Handler) Create(w http.ResponseWriter, r *http.Request) {
	var req struct {
		ID string `json:"id"`
		service.{{.NamePascal}}Input
	}
	if !decodeJSON(w, r, &req) {
		return
	}
	if err := h.svc.Create(r.Context(), req.ID, req.{{.NamePascal}}Input); err != nil {
		write{{.NamePascal}}Error(w, err)
		return
	}
	writeJSON(w, http.StatusCreated, map[string]string{"id": req.ID, "status": "created"})
}

