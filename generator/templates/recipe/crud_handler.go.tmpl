// write{{.NamePascal}}Error maps domain command errors to HTTP status codes.
func write{{.NamePascal}}Error(w http.ResponseWriter, err error) {
	switch {
	case errors.Is(err, service.Err{{.NamePascal}}Exists):
		writeError(w, http.StatusConflict, err)
	case errors.Is(err, service.Err{{.NamePascal}}NotFound):
		writeError(w, http.StatusNotFound, err)
	default:
		writeError(w, http.StatusInternalServerError, err)
	}
}

// {{.NamePascal}}QueryHandler exposes the {{.NamePascal}} read model and its
// activity log over HTTP (GET). Reads are eventually consistent: a command's
// effect shows up once the projection worker has applied its event.
type {{.NamePascal}}QueryHandler struct {
	db *gorm.DB
}

func New{{.NamePascal}}QueryHandler(db *gorm.DB) *{{.NamePascal}}QueryHandler {
	return &{{.NamePascal}}QueryHandler{db: db}
}

// List handles GET ?archived=true. Without it, only non-archived entries
// are returned.
func (h *{{.NamePascal}}QueryHandler) List(w http.ResponseWriter, r *http.Request) {
	list := projection.List{{.NamePascal}}s
	if r.URL.Query().Get("archived") == "true" {
		list = projection.ListArchived{{.NamePascal}}s
	}
	rows, err := list(r.Context(), h.db)
	if err != nil {
		writeError(w, http.StatusInternalServerError, err)
		return
	}
	writeJSON(w, http.StatusOK, map[string]any{"items": rows})
}

// Get handles GET ?id=...
func (h *{{.NamePascal}}QueryHandler) Get(w http.ResponseWriter, r *http.Request) {
	id := r.URL.Query().Get("id")
	if id == "" {
		writeError(w, http.StatusBadRequest, errors.New("id is required"))
		return
	}
	row, err := projection.Get{{.NamePascal}}(r.Context(), h.db, id)
	if errors.Is(err, gorm.ErrRecordNotFound) {
		writeError(w, http.StatusNotFound, service.Err{{.NamePascal}}NotFound)
		return
	}
	if err != nil {
		writeError(w, http.StatusInternalServerError, err)
		return
	}
	writeJSON(w, http.StatusOK, row)
}

// Activities handles GET ?id=...&page=1&page_size=20: one entity's activity
// log, newest first. Without id it returns the log across every entity.
func (h *{{.NamePascal}}QueryHandler) Activities(w http.ResponseWriter, r *http.Request) {
	page, pageSize, err := h.pagination(r)
	if err != nil {
		writeError(w, http.StatusBadRequest, err)
		return
	}
	var rows []projection.{{.NamePascal}}ActivityRow
	var total int64
	if id := r.URL.Query().Get("id"); id != "" {
		rows, total, err = projection.List{{.NamePascal}}Activities(r.Context(), h.db, id, page, pageSize)
	} else {
		rows, total, err = projection.ListRecent{{.NamePascal}}Activities(r.Context(), h.db, page, pageSize)
	}
	if err != nil {
		writeError(w, http.StatusInternalServerError, err)
		return
	}
	writeJSON(w, http.StatusOK, map[string]any{
		"items":     rows,
		"page":      page,
		"page_size": pageSize,
		"total":     total,
	})
}

// pagination reads page (default 1) and page_size (default 20, at most 100)
// from the query string.
func (h *{{.NamePascal}}QueryHandler) pagination(r *http.Request) (page, pageSize int, err error) {
	page, pageSize = 1, 20
	if v := r.URL.Query().Get("page"); v != "" {
		if page, err = strconv.Atoi(v); err != nil || page < 1 {
			return 0, 0, errors.New("page must be a positive integer")
		}
	}
	if v := r.URL.Query().Get("page_size"); v != "" {
		if pageSize, err = strconv.Atoi(v); err != nil || pageSize < 1 || pageSize > 100 {
			return 0, 0, errors.New("page_size must be between 1 and 100")
		}
	}
	return page, pageSize, nil
}
