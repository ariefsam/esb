package projection

import (
	"context"
	"errors"
	"log"
	"time"

	"gorm.io/gorm"
	"gorm.io/gorm/clause"

	"{{.ModuleName}}/eventstore"
)

// {{.NamePascal}}OutboxWorker ingests {{.NameKebab}} events into the outbox
// table, one row per event, idempotently (unique source EventID). A separate
// {{.NamePascal}}OutboxPublisher relays those rows to the outside world.
type {{.NamePascal}}OutboxWorker struct {
	events eventstore.EventRepository
	db     *gorm.DB
}

func New{{.NamePascal}}OutboxWorker(events eventstore.EventRepository, db *gorm.DB) *{{.NamePascal}}OutboxWorker {
	return &{{.NamePascal}}OutboxWorker{events: events, db: db}
}

func (w *{{.NamePascal}}OutboxWorker) Run(ctx context.Context) {
	for {
		if ctx.Err() != nil {
			return
		}
		cursor, err := w.readCursor(ctx)
		if err != nil {
			if ctx.Err() != nil {
				return
			}
			log.Printf("{{.Name}} outbox: read cursor error: %v — retrying in 3s", err)
			if !w.wait(ctx, 3*time.Second) {
				return
			}
			continue
		}
		batch, err := w.events.FetchAll(ctx, []string{"{{.NameKebab}}"}, uint(cursor), 100)
		if err != nil {
			if ctx.Err() != nil {
				return
			}
			log.Printf("{{.Name}} outbox: fetch error: %v — retrying in 3s", err)
			if !w.wait(ctx, 3*time.Second) {
				return
			}
			continue
		}
		// FetchAll returns as soon as the stream is drained — the
		// embedded store does not long-poll — so an idle worker without
		// this pause would spin a core.
		if len(batch) == 0 {
			select {
			case <-ctx.Done():
				return
			case <-time.After(500 * time.Millisecond):
			}
			continue
		}

		for _, e := range batch {
			if err := w.applyEvent(ctx, e); err != nil {
				if ctx.Err() != nil {
					return
				}
				// Stop at the first failure and re-fetch from the cursor. The
				// cursor only advances inside a successful applyEvent, so this
				// event is retried instead of skipped. An event that keeps
				// failing blocks the worker (visible in the log) rather than
				// silently leaving a hole in the read model.
				log.Printf("{{.Name}} outbox: ingest %s %d error: %v — retrying in 3s", e.EventName, e.ID, err)
				if !w.wait(ctx, 3*time.Second) {
					return
				}
				break
			}
		}
	}
}

// readCursor returns the ID of the last applied event. A missing row means
// nothing has been applied yet (0); any other error is returned so Run
// retries instead of silently replaying the stream from the start.
func (w *{{.NamePascal}}OutboxWorker) readCursor(ctx context.Context) (int64, error) {
	var row ProjectionCursorRow
	err := w.db.WithContext(ctx).Where("name = ?", "{{.Name}}_outbox").First(&row).Error
	if errors.Is(err, gorm.ErrRecordNotFound) {
		return 0, nil
	}
	return row.AfterID, err
}

// wait pauses for d and reports false if ctx was cancelled first.
func (w *{{.NamePascal}}OutboxWorker) wait(ctx context.Context, d time.Duration) bool {
	select {
	case <-ctx.Done():
		return false
	case <-time.After(d):
		return true
	}
}

func (w *{{.NamePascal}}OutboxWorker) applyEvent(ctx context.Context, e eventstore.Event) error {
	return w.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
		row := {{.NamePascal}}OutboxRow{
			EventID:     e.ID,
			AggregateID: e.AggregateID,
			EventName:   e.EventName,
			Payload:     e.Data,
			CreatedAt:   e.TimeMillis,
		}
		eventCol := clause.Column{Name: "event_id"}
		if err := tx.Clauses(clause.OnConflict{Columns: []clause.Column{eventCol}, DoNothing: true}).Create(&row).Error; err != nil {
			return err
		}

		cursorCol := clause.Column{Name: "name"}
		return tx.Clauses(clause.OnConflict{
			Columns:   []clause.Column{cursorCol},
			DoUpdates: clause.AssignmentColumns([]string{"after_id", "updated_at"}),
		}).Create(&ProjectionCursorRow{Name: "{{.Name}}_outbox", AfterID: int64(e.ID), UpdatedAt: e.TimeMillis}).Error
	})
}
