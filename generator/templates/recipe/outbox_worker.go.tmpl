package projection

import (
	"context"
	"log"
	"time"

	"gorm.io/gorm"
	"gorm.io/gorm/clause"

	"{{.ModuleName}}/eventstore"
)

// {{.NamePascal}}OutboxWorker ingests {{.NameKebab}} events into the outbox
// table, one row per event, idempotently (unique source EventID). A separate
// {{.NamePascal}}OutboxPublisher relays those rows to the outside world.
type {{.NamePascal}}OutboxWorker struct {
	esClient *eventstore.Client
	db       *gorm.DB
}

func New{{.NamePascal}}OutboxWorker(esClient *eventstore.Client, db *gorm.DB) *{{.NamePascal}}OutboxWorker {
	return &{{.NamePascal}}OutboxWorker{esClient: esClient, db: db}
}

func (w *{{.NamePascal}}OutboxWorker) Run(ctx context.Context) {
	for {
		if ctx.Err() != nil {
			return
		}
		cursor := w.readCursor(ctx)
		events, err := w.esClient.EventsAll(ctx, []string{"{{.NameKebab}}"}, uint(cursor), 100)
		if err != nil {
			if ctx.Err() != nil {
				return
			}
			log.Printf("{{.Name}} outbox: fetch error: %v — retrying in 3s", err)
			time.Sleep(3 * time.Second)
			continue
		}
		for _, e := range events {
			if err := w.applyEvent(ctx, e); err != nil {
				log.Printf("{{.Name}} outbox: ingest %s %d error: %v", e.EventName, e.ID, err)
			}
		}
	}
}

func (w *{{.NamePascal}}OutboxWorker) readCursor(ctx context.Context) int64 {
	var row ProjectionCursorRow
	w.db.WithContext(ctx).Where("name = ?", "{{.Name}}_outbox").First(&row)
	return row.AfterID
}

func (w *{{.NamePascal}}OutboxWorker) applyEvent(ctx context.Context, e eventstore.Event) error {
	return w.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
		row := {{.NamePascal}}OutboxRow{
			EventID:     e.ID,
			AggregateID: e.AggregateID,
			EventName:   e.EventName,
			Payload:     e.Data,
			CreatedAt:   e.TimeMillis,
		}
		eventCol := clause.Column{Name: "event_id"}
		if err := tx.Clauses(clause.OnConflict{Columns: []clause.Column{eventCol}, DoNothing: true}).Create(&row).Error; err != nil {
			return err
		}

		cursorCol := clause.Column{Name: "name"}
		return tx.Clauses(clause.OnConflict{
			Columns:   []clause.Column{cursorCol},
			DoUpdates: clause.AssignmentColumns([]string{"after_id", "updated_at"}),
		}).Create(&ProjectionCursorRow{Name: "{{.Name}}_outbox", AfterID: int64(e.ID), UpdatedAt: e.TimeMillis}).Error
	})
}
