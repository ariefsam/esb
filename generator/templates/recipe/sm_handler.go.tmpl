package handler

import (
	"encoding/json"
	"errors"
	"net/http"

	"{{.ModuleName}}/service"
)

// {{.NamePascal}}Handler exposes the {{.NamePascal}} state transition over HTTP.
type {{.NamePascal}}Handler struct {
	svc *service.{{.NamePascal}}Service
}

func New{{.NamePascal}}Handler(svc *service.{{.NamePascal}}Service) *{{.NamePascal}}Handler {
	return &{{.NamePascal}}Handler{svc: svc}
}

// Transition handles POST: body {"id": "...", "to": "<state>"}.
func (h *{{.NamePascal}}Handler) Transition(w http.ResponseWriter, r *http.Request) {
	var req struct {
		ID string `json:"id"`
		To string `json:"to"`
	}
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		writeError(w, http.StatusBadRequest, err)
		return
	}
	if err := h.svc.Transition(r.Context(), req.ID, req.To); err != nil {
		write{{.NamePascal}}Error(w, err)
		return
	}
	writeJSON(w, http.StatusOK, map[string]string{"id": req.ID, "state": req.To})
}

// write{{.NamePascal}}Error maps state-machine command errors to HTTP status codes.
func write{{.NamePascal}}Error(w http.ResponseWriter, err error) {
	switch {
	case errors.Is(err, service.Err{{.NamePascal}}NotFound):
		writeError(w, http.StatusNotFound, err)
	case errors.Is(err, service.Err{{.NamePascal}}UnknownState):
		writeError(w, http.StatusBadRequest, err)
	case errors.Is(err, service.Err{{.NamePascal}}InvalidTransition):
		writeError(w, http.StatusConflict, err)
	default:
		writeError(w, http.StatusInternalServerError, err)
	}
}
