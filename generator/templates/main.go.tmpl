package main

import (
	"context"
	"errors"
	"fmt"
	"log"
	"net/http"
	"os"
	"os/signal"
	"sync"
	"syscall"
	"time"

	"{{.ModuleName}}/projection"
	"{{.ModuleName}}/wire"
)

func main() {
	app, err := wire.NewApp()
	if err != nil {
		log.Fatalf("init app: %v", err)
	}

	ctx, cancel := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer cancel()

	workers := []projection.Worker{
		// esb:inject:projection-workers
	}
	var wg sync.WaitGroup
	for _, w := range workers {
		wg.Go(func() { w.Run(ctx) })
	}

	// Timeouts bound how long a slow or idle client can hold a connection
	// (slowloris). Raise WriteTimeout if a handler legitimately streams.
	srv := &http.Server{
		Addr:              app.Env.Addr,
		Handler:           app.Handler,
		ReadHeaderTimeout: 5 * time.Second,
		ReadTimeout:       15 * time.Second,
		WriteTimeout:      30 * time.Second,
		IdleTimeout:       60 * time.Second,
	}

	// On SIGINT/SIGTERM stop accepting connections and give in-flight
	// requests up to 10s to finish.
	shutdownDone := make(chan struct{})
	go func() {
		defer close(shutdownDone)
		<-ctx.Done()
		shutdownCtx, cancelShutdown := context.WithTimeout(context.Background(), 10*time.Second)
		defer cancelShutdown()
		if err := srv.Shutdown(shutdownCtx); err != nil {
			log.Printf("shutdown: %v", err)
		}
	}()

	fmt.Printf("Starting {{.PackageName}} on %s\n", app.Env.Addr)
	if err := srv.ListenAndServe(); err != nil && !errors.Is(err, http.ErrServerClosed) {
		log.Fatalf("server: %v", err)
	}
	// ListenAndServe returns as soon as Shutdown begins: wait for the drain,
	// then for the workers to finish the event they are applying.
	<-shutdownDone
	wg.Wait()
}
