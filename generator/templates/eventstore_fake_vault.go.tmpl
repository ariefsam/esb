package eventstore

import (
	"context"
	"encoding/json"
	"errors"
)

// ShredSubjects implements Shredder for tests: it drops the subjects'
// entries from every stored Event.Protected, like the embedded store.
// (Generated by `esb init` only — `esb update-client` leaves this file to
// the project.)
func (s *FakeStore) ShredSubjects(ctx context.Context, subjects ...string) ([]string, error) {
	if len(subjects) == 0 {
		return nil, errors.New("shred: no subjects")
	}
	s.mu.Lock()
	defer s.mu.Unlock()

	drop := make(map[string]bool, len(subjects))
	for _, sub := range subjects {
		drop[sub] = true
	}
	for i, e := range s.events {
		if len(e.Protected) == 0 {
			continue
		}
		// Copy rather than delete in place: events returned earlier share
		// the old map and must not change under their holders.
		kept := make(map[string]json.RawMessage, len(e.Protected))
		for sub, payload := range e.Protected {
			if !drop[sub] {
				kept[sub] = payload
			}
		}
		s.events[i].Protected = kept
	}
	return subjects, nil
}
