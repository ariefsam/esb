# Mode event store: "embedded" (lokal, SQLite) atau "esb-server" (remote HTTP)
# Default: embedded — tidak butuh server ESB hidup untuk develop lokal.
EVENT_STORE_MODE=embedded
# Opsional: lokasi SQLite khusus event store. Kalau kosong, event store
# memakai DB_DSN dan berbagi satu koneksi GORM dengan projection DB.
# Kalau diisi berbeda, event dan projection sengaja disimpan di file terpisah.
EVENT_STORE_DSN=

# Hanya dipakai saat EVENT_STORE_MODE=esb-server
ESB_URL=http://localhost:8080
TENANT_ID=my-tenant
PROJECT_ID={{.PackageName}}
JWT_ISSUER={{.PackageName}}
# Scope token untuk vault ESB (dipisah spasi). vault:encrypt/vault:decrypt
# dibutuhkan untuk Event.Protected; tambahkan vault:shred hanya di proses
# yang menangani penghapusan data subjek.
ESB_SCOPES=vault:encrypt vault:decrypt

# Secret aplikasi (App.Secrets): di esb-server dibaca dari vault ESB
# (/vault/secrets), di embedded dari env SECRET_<REF> — ref "billing/db/dsn"
# dibaca dari SECRET_BILLING_DB_DSN.
# SECRET_BILLING_DB_DSN=

# Projection DB (dipakai juga oleh embedded event store bila EVENT_STORE_DSN kosong)
DB_DSN={{.PackageName}}.db

ADDR=:9000