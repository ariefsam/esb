package projection

import (
	"context"
	"encoding/json"
	"log"
	"strings"
	"time"

	"gorm.io/gorm"
	"gorm.io/gorm/clause"

	"{{.ModuleName}}/domain"
	"{{.ModuleName}}/eventstore"
)

// {{.ProjectionNamePascal}}ProjectionWorker builds the {{.ProjectionName}} read model
// by listening to events from: {{range $i, $a := .AggregateNames}}{{if $i}}, {{end}}{{$a}}{{end}}.
type {{.ProjectionNamePascal}}ProjectionWorker struct {
	events eventstore.EventRepository
	db     *gorm.DB
}

var {{.ProjectionName}}AggregateNames = []string{
	{{- range .AggregateNames}}
	"{{.}}",
	{{- end}}
}

// New{{.ProjectionNamePascal}}ProjectionWorker takes the EventRepository rather
// than the HTTP client, so the worker runs unchanged against the embedded
// SQLite store (where there is no client) and against a remote ESB server.
func New{{.ProjectionNamePascal}}ProjectionWorker(events eventstore.EventRepository, db *gorm.DB) *{{.ProjectionNamePascal}}ProjectionWorker {
	return &{{.ProjectionNamePascal}}ProjectionWorker{events: events, db: db}
}

func (w *{{.ProjectionNamePascal}}ProjectionWorker) Run(ctx context.Context) {
	for {
		if ctx.Err() != nil {
			return
		}

		cursor := w.readCursor(ctx)
		batch, err := w.events.FetchAll(ctx, {{.ProjectionName}}AggregateNames, uint(cursor), 100)
		if err != nil {
			if ctx.Err() != nil {
				return
			}
			log.Printf("{{.ProjectionName}} projection: fetch error: %v — retrying in 3s", err)
			time.Sleep(3 * time.Second)
			continue
		}

		// FetchAll returns as soon as the stream is drained — the
		// embedded store does not long-poll — so an idle worker without
		// this pause would spin a core.
		if len(batch) == 0 {
			select {
			case <-ctx.Done():
				return
			case <-time.After(500 * time.Millisecond):
			}
			continue
		}

		for _, e := range batch {
			if err := w.applyEvent(ctx, e); err != nil {
				log.Printf("{{.ProjectionName}} projection: apply %s/%s %d error: %v",
					e.AggregateName, e.EventName, e.ID, err)
			}
		}
	}
}

func (w *{{.ProjectionNamePascal}}ProjectionWorker) readCursor(ctx context.Context) int64 {
	var row ProjectionCursorRow
	w.db.WithContext(ctx).Where("name = ?", "{{.ProjectionName}}").First(&row)
	return row.AfterID
}

func (w *{{.ProjectionNamePascal}}ProjectionWorker) applyEvent(ctx context.Context, e eventstore.Event) error {
	return w.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
		switch e.AggregateName {
		// esb:inject:applyevent-cases
		default:
			_ = domain.Event{} // keep domain import
		}

		cursorCol := clause.Column{Name: "name"}
		return tx.Clauses(clause.OnConflict{
			Columns:   []clause.Column{cursorCol},
			DoUpdates: clause.AssignmentColumns([]string{"after_id", "updated_at"}),
		}).Create(&ProjectionCursorRow{
			Name:      "{{.ProjectionName}}",
			AfterID:   int64(e.ID),
			UpdatedAt: e.TimeMillis,
		}).Error
	})
}

