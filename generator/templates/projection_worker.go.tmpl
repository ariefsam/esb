package projection

import (
	"context"
	"encoding/json"
	"log"
	"time"

	"gorm.io/gorm"
	"gorm.io/gorm/clause"

	"{{.ModuleName}}/domain"
	"{{.ModuleName}}/eventstore"
)

// {{.AggregateNamePascal}}ProjectionWorker keeps the {{.AggregateNamePascal}} read model up to date
// by polling the event store and applying events transactionally.
type {{.AggregateNamePascal}}ProjectionWorker struct {
	events eventstore.EventRepository
	db     *gorm.DB
}

// New{{.AggregateNamePascal}}ProjectionWorker takes the EventRepository rather
// than the HTTP client, so the worker runs unchanged against the embedded
// SQLite store (where there is no client) and against a remote ESB server.
func New{{.AggregateNamePascal}}ProjectionWorker(events eventstore.EventRepository, db *gorm.DB) *{{.AggregateNamePascal}}ProjectionWorker {
	return &{{.AggregateNamePascal}}ProjectionWorker{events: events, db: db}
}

func (w *{{.AggregateNamePascal}}ProjectionWorker) Run(ctx context.Context) {
	for {
		if ctx.Err() != nil {
			return
		}

		cursor := w.readCursor(ctx)
		batch, err := w.events.FetchAll(ctx, []string{"{{.AggregateNameKebab}}"}, uint(cursor), 100)
		if err != nil {
			if ctx.Err() != nil {
				return
			}
			log.Printf("{{.AggregateName}} projection: fetch error: %v — retrying in 3s", err)
			time.Sleep(3 * time.Second)
			continue
		}

		// FetchAll returns as soon as the stream is drained — the
		// embedded store does not long-poll — so an idle worker without
		// this pause would spin a core.
		if len(batch) == 0 {
			select {
			case <-ctx.Done():
				return
			case <-time.After(500 * time.Millisecond):
			}
			continue
		}

		for _, e := range batch {
			if err := w.applyEvent(ctx, e); err != nil {
				log.Printf("{{.AggregateName}} projection: apply %s %d error: %v", e.EventName, e.ID, err)
			}
		}
	}
}

func (w *{{.AggregateNamePascal}}ProjectionWorker) readCursor(ctx context.Context) int64 {
	var row ProjectionCursorRow
	w.db.WithContext(ctx).Where("name = ?", "{{.AggregateName}}").First(&row)
	return row.AfterID
}

func (w *{{.AggregateNamePascal}}ProjectionWorker) applyEvent(ctx context.Context, e eventstore.Event) error {
	return w.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
		switch e.EventName {
		// esb:inject:applyevent-cases
		default:
			_ = domain.{{.AggregateNamePascal}}AggregateName // keep import
		}

		cursorCol := clause.Column{Name: "name"}
		return tx.Clauses(clause.OnConflict{
			Columns:   []clause.Column{cursorCol},
			DoUpdates: clause.AssignmentColumns([]string{"after_id", "updated_at"}),
		}).Create(&ProjectionCursorRow{
			Name:      "{{.AggregateName}}",
			AfterID:   int64(e.ID),
			UpdatedAt: e.TimeMillis,
		}).Error
	})
}

