// Package eventstore provides a local SQLite-backed implementation of
// the EventRepository interface. It mirrors the wire shape of the
// HTTP client so callers (handlers, services, projection workers)
// can switch between embedded and remote stores without changing
// anything but the constructor.
package eventstore

import (
	"context"
	"database/sql"
	"encoding/json"
	"errors"
	"fmt"
	"time"

	"gorm.io/gorm"
	"gorm.io/gorm/clause"
)

// EventRow is the SQLite representation of a stored event. ID is
// autoincrement so the projection worker can use it as an opaque
// cursor. The other columns map 1:1 to the HTTP Event fields.
type EventRow struct {
	ID             uint   `gorm:"primaryKey;autoIncrement"`
	AggregateName  string `gorm:"column:aggregate_name;not null;index:idx_events_agg_version,priority:1;index:idx_events_agg_id,priority:1"`
	AggregateID    string `gorm:"column:aggregate_id;not null;index:idx_events_agg_id,priority:2"`
	EventName      string `gorm:"column:event_name;not null"`
	Version        int64  `gorm:"column:version;not null;index:idx_events_agg_version,priority:2"`
	Data           []byte `gorm:"column:data"`
	TimeMillis     int64  `gorm:"column:time_millis;not null"`
	CorrelationID  string `gorm:"column:correlation_id"`
	CausationID    string `gorm:"column:causation_id"`
	IdempotencyKey string `gorm:"column:idempotency_key;index"`
}

func (EventRow) TableName() string { return "events" }

// LocalStore is the embedded EventRepository. It is safe for
// concurrent use by StoreAtomic because GORM serializes writes
// inside its own transaction. Retrieve and FetchAll issue plain
// SELECTs and do not block writers.
type LocalStore struct {
	db *gorm.DB
}

// NewLocalStore wraps an existing *gorm.DB. The caller is responsible
// for running AutoMigrate(&EventRow{}) on the same DB before the
// first Store call so the events table exists.
func NewLocalStore(db *gorm.DB) *LocalStore {
	return &LocalStore{db: db}
}

// StoreAtomic inserts a new event if and only if (aggregate_name,
// aggregate_id, version) does not already exist. The version check
// implements optimistic concurrency: two concurrent writers for the
// same aggregate that race on version produce a unique constraint
// violation and the loser receives ErrConflict.
//
// expectedVersion is honored as follows:
//   - 0  → the new event must be the first event for this aggregate
//     (version=1). Use this on the very first store.
//   - N>0 → the previous stored version must equal N-1.
//
// On success the stored EventRow is returned with its database ID
// populated so callers can use it as a cursor for projection.
func (s *LocalStore) StoreAtomic(ctx context.Context, e Event, expectedVersion int64) (Event, error) {
	if expectedVersion < 0 {
		return Event{}, fmt.Errorf("expectedVersion must be >= 0, got %d", expectedVersion)
	}
	// Compute the row's version we expect to find currently in the
	// store. expectedVersion=0 means there is no previous event, so
	// the new row's version=1 must not collide.
	row := EventRow{
		AggregateName:  e.AggregateName,
		AggregateID:    e.AggregateID,
		EventName:      e.EventName,
		Version:        expectedVersion + 1,
		Data:           []byte(e.Data),
		TimeMillis:     e.TimeMillis,
		CorrelationID:  e.CorrelationID,
		CausationID:    e.CausationID,
		IdempotencyKey: e.IdempotencyKey,
	}
	if row.TimeMillis == 0 {
		row.TimeMillis = time.Now().UnixMilli()
	}

	// Translate optimistic-lock collision into ErrConflict so
	// handlers can react without parsing gorm error strings.
	err := s.db.WithContext(ctx).
		Clauses(clause.OnConflict{DoNothing: true}).
		Create(&row).Error
	if err != nil {
		return Event{}, fmt.Errorf("insert event: %w", err)
	}
	if row.ID == 0 {
		// OnConflict.DoNothing leaves ID at zero when the row
		// already existed — that is a duplicate version collision.
		return Event{}, ErrConflict
	}
	return Event{
		ID:             row.ID,
		AggregateName:  row.AggregateName,
		AggregateID:    row.AggregateID,
		EventName:      row.EventName,
		Version:        row.Version,
		Data:           json.RawMessage(row.Data),
		TimeMillis:     row.TimeMillis,
		CorrelationID:  row.CorrelationID,
		CausationID:    row.CausationID,
		IdempotencyKey: row.IdempotencyKey,
	}, nil
}

// Retrieve returns every event for an aggregate instance with
// version > afterVersion, ordered by version ASC. afterVersion=0
// returns the full stream.
func (s *LocalStore) Retrieve(ctx context.Context, aggregateID, aggregateName string, afterVersion int64) ([]Event, error) {
	var rows []EventRow
	err := s.db.WithContext(ctx).
		Where("aggregate_id = ? AND aggregate_name = ? AND version > ?", aggregateID, aggregateName, afterVersion).
		Order("version ASC").
		Find(&rows).Error
	if err != nil {
		return nil, fmt.Errorf("retrieve events: %w", err)
	}
	return rowsToEvents(rows), nil
}

// FetchAll streams events across one or more aggregate types with
// cursor-based pagination. afterID is the opaque event-row ID;
// limit caps the response (caller passes 0 for "all"). Used by the
// projection worker.
func (s *LocalStore) FetchAll(ctx context.Context, aggregateNames []string, afterID uint, limit int) ([]Event, error) {
	var rows []EventRow
	q := s.db.WithContext(ctx).Where("id > ?", afterID).Order("id ASC")
	if len(aggregateNames) > 0 {
		q = q.Where("aggregate_name IN ?", aggregateNames)
	}
	if limit > 0 {
		q = q.Limit(limit)
	}
	if err := q.Find(&rows).Error; err != nil {
		return nil, fmt.Errorf("fetch events: %w", err)
	}
	return rowsToEvents(rows), nil
}

func rowsToEvents(rows []EventRow) []Event {
	out := make([]Event, len(rows))
	for i, r := range rows {
		out[i] = Event{
			ID:             r.ID,
			AggregateName:  r.AggregateName,
			AggregateID:    r.AggregateID,
			EventName:      r.EventName,
			Version:        r.Version,
			Data:           json.RawMessage(r.Data),
			TimeMillis:     r.TimeMillis,
			CorrelationID:  r.CorrelationID,
			CausationID:    r.CausationID,
			IdempotencyKey: r.IdempotencyKey,
		}
	}
	return out
}

// MigrateLocalStore runs AutoMigrate for the events table. Call this
// once at startup before constructing LocalStore.
func MigrateLocalStore(db *gorm.DB) error {
	if db == nil {
		return errors.New("nil db")
	}
	return db.AutoMigrate(&EventRow{})
}

// CountByAggregate returns the number of events per aggregate name.
// Useful for the UI / dashboard summary. Returns an empty map when
// the events table does not exist.
func (s *LocalStore) CountByAggregate(ctx context.Context) (map[string]int, error) {
	type row struct {
		AggregateName string
		Count         int
	}
	var rows []row
	err := s.db.WithContext(ctx).
		Table("events").
		Select("aggregate_name, COUNT(*) AS count").
		Group("aggregate_name").
		Scan(&rows).Error
	if err != nil {
		return nil, fmt.Errorf("count events: %w", err)
	}
	out := make(map[string]int, len(rows))
	for _, r := range rows {
		out[r.AggregateName] = r.Count
	}
	return out, nil
}

// AsSQLDB exposes the underlying *sql.DB when the migration runner
// needs to read the embedded store directly. Returned handle is
// shared — do not close.
func (s *LocalStore) AsSQLDB() (*sql.DB, error) {
	if s.db == nil {
		return nil, errors.New("nil local store db")
	}
	return s.db.DB()
}