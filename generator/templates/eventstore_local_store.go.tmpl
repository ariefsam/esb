// Package eventstore provides a local SQLite-backed implementation of
// the EventRepository interface. It mirrors the wire shape of the
// HTTP client so callers (handlers, services, projection workers)
// can switch between embedded and remote stores without changing
// anything but the constructor.
package eventstore

import (
	"context"
	"database/sql"
	"encoding/json"
	"errors"
	"fmt"
	"log/slog"
	"sync"
	"time"

	"gorm.io/gorm"
	"gorm.io/gorm/clause"
)

// EventRow is the SQLite representation of a stored event. ID is
// autoincrement so the projection worker can use it as an opaque
// cursor. The other columns map 1:1 to the HTTP Event fields.
type EventRow struct {
	ID             uint   `gorm:"primaryKey;autoIncrement"`
	AggregateName  string `gorm:"column:aggregate_name;not null;index:idx_events_agg_version,priority:1;index:idx_events_agg_id,priority:1"`
	AggregateID    string `gorm:"column:aggregate_id;not null;index:idx_events_agg_id,priority:2"`
	EventName      string `gorm:"column:event_name;not null"`
	Version        int64  `gorm:"column:version;not null;index:idx_events_agg_version,priority:2"`
	Data           []byte `gorm:"column:data"`
	TimeMillis     int64  `gorm:"column:time_millis;not null"`
	CorrelationID  string `gorm:"column:correlation_id"`
	CausationID    string `gorm:"column:causation_id"`
	IdempotencyKey string `gorm:"column:idempotency_key;index"`
}

func (EventRow) TableName() string { return "events" }

// SnapshotRow is the SQLite representation of a stored aggregate
// snapshot. Only the latest row per (aggregate_name, aggregate_id) is
// read by LatestSnapshot, but older rows are kept for now — callers
// wanting retention/compaction can prune by TimeMillis or ID.
type SnapshotRow struct {
	ID            uint   `gorm:"primaryKey;autoIncrement"`
	AggregateName string `gorm:"column:aggregate_name;not null;index:idx_snapshots_agg,priority:1"`
	AggregateID   string `gorm:"column:aggregate_id;not null;index:idx_snapshots_agg,priority:2"`
	Version       int64  `gorm:"column:version;not null"`
	State         []byte `gorm:"column:state"`
	TimeMillis    int64  `gorm:"column:time_millis;not null"`
}

func (SnapshotRow) TableName() string { return "snapshots" }

// LockRow is the SQLite representation of a held distributed lock.
// Key is the primary key, so acquiring a currently-unheld or expired
// key upserts this row rather than inserting a duplicate.
type LockRow struct {
	Key        string `gorm:"column:key;primaryKey"`
	OwnerToken string `gorm:"column:owner_token;not null"`
	ExpiresAt  int64  `gorm:"column:expires_at;not null"` // unix millis
}

func (LockRow) TableName() string { return "locks" }

// ProtectedRow is one subject's Event.Protected payload of one event.
// Embedded mode keeps it UNENCRYPTED — use EVENT_STORE_MODE=esb-server for
// real personal data, where the ESB vault encrypts it per subject. It
// lives in its own table so ShredSubjects can delete a subject's data
// without rewriting events.
type ProtectedRow struct {
	EventID uint   `gorm:"column:event_id;primaryKey"`
	Subject string `gorm:"column:subject;primaryKey;index"`
	Payload []byte `gorm:"column:payload;not null"`
}

func (ProtectedRow) TableName() string { return "event_protected" }

var protectedWarnOnce sync.Once

func warnUnencryptedProtected() {
	protectedWarnOnce.Do(func() {
		slog.Warn("embedded event store keeps Event.Protected UNENCRYPTED; use EVENT_STORE_MODE=esb-server for real personal data")
	})
}

// protectedRows turns one event's Protected map into rows.
func protectedRows(eventID uint, protected map[string]json.RawMessage) []ProtectedRow {
	rows := make([]ProtectedRow, 0, len(protected))
	for subject, payload := range protected {
		rows = append(rows, ProtectedRow{EventID: eventID, Subject: subject, Payload: []byte(payload)})
	}
	return rows
}

// loadProtected returns the protected payloads of the given events, keyed
// by event ID. A store that predates the event_protected table has none.
func (s *LocalStore) loadProtected(ctx context.Context, eventIDs []uint) (map[uint]map[string]json.RawMessage, error) {
	if len(eventIDs) == 0 || !s.db.Migrator().HasTable(&ProtectedRow{}) {
		return nil, nil
	}
	out := map[uint]map[string]json.RawMessage{}
	const chunk = 500
	for start := 0; start < len(eventIDs); start += chunk {
		end := min(start+chunk, len(eventIDs))
		var rows []ProtectedRow
		if err := s.db.WithContext(ctx).Where("event_id IN ?", eventIDs[start:end]).Find(&rows).Error; err != nil {
			return nil, fmt.Errorf("load protected: %w", err)
		}
		for _, r := range rows {
			if out[r.EventID] == nil {
				out[r.EventID] = map[string]json.RawMessage{}
			}
			out[r.EventID][r.Subject] = json.RawMessage(r.Payload)
		}
	}
	return out, nil
}

// ShredSubjects implements Shredder. Embedded mode has no keys to destroy,
// so it deletes every protected payload of the subjects; events and their
// Data are untouched. Unlike the ESB vault it leaves no tombstone: the
// same subject can be written again afterwards.
func (s *LocalStore) ShredSubjects(ctx context.Context, subjects ...string) ([]string, error) {
	if len(subjects) == 0 {
		return nil, errors.New("shred: no subjects")
	}
	if s.db.Migrator().HasTable(&ProtectedRow{}) {
		if err := s.db.WithContext(ctx).Where("subject IN ?", subjects).Delete(&ProtectedRow{}).Error; err != nil {
			return nil, fmt.Errorf("shred: %w", err)
		}
	}
	return subjects, nil
}

// LocalStore is the embedded EventRepository. It is safe for
// concurrent use by StoreAtomic because GORM serializes writes
// inside its own transaction. Retrieve and FetchAll issue plain
// SELECTs and do not block writers.
type LocalStore struct {
	db *gorm.DB
}

// NewLocalStore wraps an existing *gorm.DB. The caller is responsible
// for running AutoMigrate(&EventRow{}) on the same DB before the
// first Store call so the events table exists.
func NewLocalStore(db *gorm.DB) *LocalStore {
	return &LocalStore{db: db}
}

// StoreAtomic inserts a new event if and only if (aggregate_name,
// aggregate_id, version) does not already exist. The version check
// implements optimistic concurrency: two concurrent writers for the
// same aggregate that race on version produce a unique constraint
// violation and the loser receives ErrConflict.
//
// expectedVersion is honored as follows:
//   - 0  → the new event must be the first event for this aggregate
//     (version=1). Use this on the very first store.
//   - N>0 → the previous stored version must equal N-1.
//
// On success the stored EventRow is returned with its database ID
// populated so callers can use it as a cursor for projection.
func (s *LocalStore) StoreAtomic(ctx context.Context, e Event, expectedVersion int64) (Event, error) {
	if expectedVersion < 0 {
		return Event{}, fmt.Errorf("expectedVersion must be >= 0, got %d", expectedVersion)
	}
	// Compute the row's version we expect to find currently in the
	// store. expectedVersion=0 means there is no previous event, so
	// the new row's version=1 must not collide.
	row := EventRow{
		AggregateName:  e.AggregateName,
		AggregateID:    e.AggregateID,
		EventName:      e.EventName,
		Version:        expectedVersion + 1,
		Data:           []byte(e.Data),
		TimeMillis:     e.TimeMillis,
		CorrelationID:  e.CorrelationID,
		CausationID:    e.CausationID,
		IdempotencyKey: e.IdempotencyKey,
	}
	if row.TimeMillis == 0 {
		row.TimeMillis = time.Now().UnixMilli()
	}

	// Enforce optimistic concurrency inside one transaction. The
	// aggregate row with the highest version must exactly match the
	// caller's expectedVersion before a new version is inserted.
	err := s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
		var current int64
		if err := tx.Model(&EventRow{}).
			Where("aggregate_name = ? AND aggregate_id = ?", e.AggregateName, e.AggregateID).
			Select("COALESCE(MAX(version), 0)").Scan(&current).Error; err != nil {
			return err
		}
		if current != expectedVersion {
			return ErrConflict
		}
		result := tx.Clauses(clause.OnConflict{DoNothing: true}).Create(&row)
		if result.Error != nil {
			return result.Error
		}
		if row.ID == 0 {
			return ErrConflict
		}
		if len(e.Protected) > 0 {
			warnUnencryptedProtected()
			if err := tx.Create(protectedRows(row.ID, e.Protected)).Error; err != nil {
				return err
			}
		}
		return nil
	})
	if errors.Is(err, ErrConflict) {
		return Event{}, ErrConflict
	}
	if err != nil {
		return Event{}, fmt.Errorf("insert event: %w", err)
	}
	return Event{
		ID:             row.ID,
		AggregateName:  row.AggregateName,
		AggregateID:    row.AggregateID,
		EventName:      row.EventName,
		Version:        row.Version,
		Data:           json.RawMessage(row.Data),
		TimeMillis:     row.TimeMillis,
		CorrelationID:  row.CorrelationID,
		CausationID:    row.CausationID,
		IdempotencyKey: row.IdempotencyKey,
		Protected:      e.Protected,
	}, nil
}

// Retrieve returns every event for an aggregate instance with
// version > afterVersion, ordered by version ASC. afterVersion=0
// returns the full stream.
func (s *LocalStore) Retrieve(ctx context.Context, aggregateID, aggregateName string, afterVersion int64) ([]Event, error) {
	var rows []EventRow
	err := s.db.WithContext(ctx).
		Where("aggregate_id = ? AND aggregate_name = ? AND version > ?", aggregateID, aggregateName, afterVersion).
		Order("version ASC").
		Find(&rows).Error
	if err != nil {
		return nil, fmt.Errorf("retrieve events: %w", err)
	}
	protected, err := s.loadProtected(ctx, rowIDs(rows))
	if err != nil {
		return nil, err
	}
	return rowsToEvents(rows, protected), nil
}

// FetchAll streams events across one or more aggregate types with
// cursor-based pagination. afterID is the opaque event-row ID;
// limit caps the response (caller passes 0 for "all"). Used by the
// projection worker.
func (s *LocalStore) FetchAll(ctx context.Context, aggregateNames []string, afterID uint, limit int) ([]Event, error) {
	var rows []EventRow
	q := s.db.WithContext(ctx).Where("id > ?", afterID).Order("id ASC")
	if len(aggregateNames) > 0 {
		q = q.Where("aggregate_name IN ?", aggregateNames)
	}
	if limit > 0 {
		q = q.Limit(limit)
	}
	if err := q.Find(&rows).Error; err != nil {
		return nil, fmt.Errorf("fetch events: %w", err)
	}
	protected, err := s.loadProtected(ctx, rowIDs(rows))
	if err != nil {
		return nil, err
	}
	return rowsToEvents(rows, protected), nil
}

// StoreSnapshot persists a new snapshot row for an aggregate instance.
// It does not delete or overwrite prior snapshots.
func (s *LocalStore) StoreSnapshot(ctx context.Context, aggregateName, aggregateID string, version int64, state json.RawMessage) (Snapshot, error) {
	row := SnapshotRow{
		AggregateName: aggregateName,
		AggregateID:   aggregateID,
		Version:       version,
		State:         []byte(state),
		TimeMillis:    time.Now().UnixMilli(),
	}
	if err := s.db.WithContext(ctx).Create(&row).Error; err != nil {
		return Snapshot{}, fmt.Errorf("insert snapshot: %w", err)
	}
	return Snapshot{
		ID:            row.ID,
		AggregateName: row.AggregateName,
		AggregateID:   row.AggregateID,
		Version:       row.Version,
		State:         json.RawMessage(row.State),
		TimeMillis:    row.TimeMillis,
	}, nil
}

// LatestSnapshot returns the highest-version snapshot row for an
// aggregate instance, or ErrSnapshotNotFound if none exists yet.
func (s *LocalStore) LatestSnapshot(ctx context.Context, aggregateID, aggregateName string) (Snapshot, error) {
	var row SnapshotRow
	err := s.db.WithContext(ctx).
		Where("aggregate_id = ? AND aggregate_name = ?", aggregateID, aggregateName).
		Order("version DESC").
		First(&row).Error
	if errors.Is(err, gorm.ErrRecordNotFound) {
		return Snapshot{}, ErrSnapshotNotFound
	}
	if err != nil {
		return Snapshot{}, fmt.Errorf("query snapshot: %w", err)
	}
	return Snapshot{
		ID:            row.ID,
		AggregateName: row.AggregateName,
		AggregateID:   row.AggregateID,
		Version:       row.Version,
		State:         json.RawMessage(row.State),
		TimeMillis:    row.TimeMillis,
	}, nil
}

func rowsToEvents(rows []EventRow, protected map[uint]map[string]json.RawMessage) []Event {
	out := make([]Event, len(rows))
	for i, r := range rows {
		out[i] = Event{
			ID:             r.ID,
			AggregateName:  r.AggregateName,
			AggregateID:    r.AggregateID,
			EventName:      r.EventName,
			Version:        r.Version,
			Data:           json.RawMessage(r.Data),
			TimeMillis:     r.TimeMillis,
			CorrelationID:  r.CorrelationID,
			CausationID:    r.CausationID,
			IdempotencyKey: r.IdempotencyKey,
			Protected:      protected[r.ID],
		}
	}
	return out
}

// rowIDs returns the IDs of rows, for loadProtected.
func rowIDs(rows []EventRow) []uint {
	ids := make([]uint, len(rows))
	for i, r := range rows {
		ids[i] = r.ID
	}
	return ids
}

// MigrateLocalStore runs AutoMigrate for the events, snapshots, locks and
// event_protected tables. Call this once at startup before constructing
// LocalStore.
func MigrateLocalStore(db *gorm.DB) error {
	if db == nil {
		return errors.New("nil db")
	}
	return db.AutoMigrate(&EventRow{}, &SnapshotRow{}, &LockRow{}, &ProtectedRow{})
}

// AcquireLock implements Locker. Embedded mode is a single process,
// so contention is expected to be rare and short-lived; a wait is
// therefore implemented as simple polling rather than a condition
// variable per key (which the HTTP server uses for its cross-process
// long-poll).
func (s *LocalStore) AcquireLock(ctx context.Context, key, ownerToken string, ttlSeconds, waitTimeoutMillis int) (Lock, error) {
	deadline := time.Now().Add(time.Duration(waitTimeoutMillis) * time.Millisecond)
	for {
		lock, err := s.tryAcquireLock(ctx, key, ownerToken, ttlSeconds)
		if err == nil {
			return lock, nil
		}
		if !errors.Is(err, ErrLockBusy) || waitTimeoutMillis <= 0 || !time.Now().Before(deadline) {
			return Lock{}, err
		}
		select {
		case <-ctx.Done():
			return Lock{}, ctx.Err()
		case <-time.After(50 * time.Millisecond):
		}
	}
}

func (s *LocalStore) tryAcquireLock(ctx context.Context, key, ownerToken string, ttlSeconds int) (Lock, error) {
	now := time.Now()
	expiresAt := now.Add(time.Duration(ttlSeconds) * time.Second)
	var result Lock
	err := s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
		var row LockRow
		err := tx.Where("key = ?", key).First(&row).Error
		switch {
		case errors.Is(err, gorm.ErrRecordNotFound):
			// No current holder.
		case err != nil:
			return err
		default:
			if time.UnixMilli(row.ExpiresAt).After(now) && row.OwnerToken != ownerToken {
				return ErrLockBusy
			}
			// Expired, or the same owner re-acquiring (refreshes the TTL).
		}
		row = LockRow{Key: key, OwnerToken: ownerToken, ExpiresAt: expiresAt.UnixMilli()}
		// Built as a separate variable, not inlined as a slice-of-struct
		// literal, because the generator renders this file through
		// text/template, which reads two adjacent opening braces as
		// the start of a template action.
		keyColumn := clause.Column{Name: "key"}
		if err := tx.Clauses(clause.OnConflict{
			Columns:   []clause.Column{keyColumn},
			DoUpdates: clause.AssignmentColumns([]string{"owner_token", "expires_at"}),
		}).Create(&row).Error; err != nil {
			return err
		}
		result = Lock{Key: key, OwnerToken: ownerToken, ExpiresAt: expiresAt, Held: true}
		return nil
	})
	if err != nil {
		return Lock{}, err
	}
	return result, nil
}

// ReleaseLock implements Locker.
func (s *LocalStore) ReleaseLock(ctx context.Context, key, ownerToken string) error {
	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
		var row LockRow
		err := tx.Where("key = ?", key).First(&row).Error
		if errors.Is(err, gorm.ErrRecordNotFound) {
			return nil // already gone; releasing an expired lock is success
		}
		if err != nil {
			return err
		}
		if row.OwnerToken != ownerToken {
			return ErrLockNotOwned
		}
		return tx.Delete(&LockRow{}, "key = ?", key).Error
	})
}

// RefreshLock implements Locker.
func (s *LocalStore) RefreshLock(ctx context.Context, key, ownerToken string, ttlSeconds int) (Lock, error) {
	now := time.Now()
	expiresAt := now.Add(time.Duration(ttlSeconds) * time.Second)
	var result Lock
	err := s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
		var row LockRow
		err := tx.Where("key = ?", key).First(&row).Error
		if errors.Is(err, gorm.ErrRecordNotFound) {
			return ErrLockNotOwned
		}
		if err != nil {
			return err
		}
		if row.OwnerToken != ownerToken || !time.UnixMilli(row.ExpiresAt).After(now) {
			return ErrLockNotOwned
		}
		row.ExpiresAt = expiresAt.UnixMilli()
		if err := tx.Save(&row).Error; err != nil {
			return err
		}
		result = Lock{Key: key, OwnerToken: ownerToken, ExpiresAt: expiresAt, Held: true}
		return nil
	})
	if err != nil {
		return Lock{}, err
	}
	return result, nil
}

// GetLock implements Locker.
func (s *LocalStore) GetLock(ctx context.Context, key string) (Lock, error) {
	var row LockRow
	err := s.db.WithContext(ctx).Where("key = ?", key).First(&row).Error
	if errors.Is(err, gorm.ErrRecordNotFound) {
		return Lock{Key: key, Held: false}, nil
	}
	if err != nil {
		return Lock{}, fmt.Errorf("query lock: %w", err)
	}
	expiresAt := time.UnixMilli(row.ExpiresAt)
	lock := Lock{Key: row.Key, ExpiresAt: expiresAt, Held: expiresAt.After(time.Now())}
	if lock.Held {
		lock.OwnerToken = row.OwnerToken
	}
	return lock, nil
}

// CountByAggregate returns the number of events per aggregate name.
// Useful for the UI / dashboard summary. Returns an empty map when
// the events table does not exist.
func (s *LocalStore) CountByAggregate(ctx context.Context) (map[string]int, error) {
	type row struct {
		AggregateName string
		Count         int
	}
	var rows []row
	err := s.db.WithContext(ctx).
		Table("events").
		Select("aggregate_name, COUNT(*) AS count").
		Group("aggregate_name").
		Scan(&rows).Error
	if err != nil {
		return nil, fmt.Errorf("count events: %w", err)
	}
	out := make(map[string]int, len(rows))
	for _, r := range rows {
		out[r.AggregateName] = r.Count
	}
	return out, nil
}

// AsSQLDB exposes the underlying *sql.DB when the migration runner
// needs to read the embedded store directly. Returned handle is
// shared — do not close.
func (s *LocalStore) AsSQLDB() (*sql.DB, error) {
	if s.db == nil {
		return nil, errors.New("nil local store db")
	}
	return s.db.DB()
}
